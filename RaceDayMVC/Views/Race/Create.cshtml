@model RaceDayMVC.Models.Race

<h2>Create Race</h2>

<form asp-action="Create" enctype="multipart/form-data">

    <div class="mb-3">
        <label class="form-label">Banner Image</label>
        <input asp-for="BannerFile" type="file" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Name</label>
        <input asp-for="Name" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Description</label>
        <input asp-for="Description" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Event Type</label>
        <input asp-for="EventType" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Date</label>
        <input asp-for="Date" type="date" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Location</label>
        <input asp-for="Location" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Distance</label>
        <input asp-for="Distance" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Organizer ID</label>
        <input asp-for="OrgID" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">
        Create Race
    </button>

</form>
