@model RaceDayMVC.ViewModels.LoginViewModel

<h2>Login</h2>

<form asp-action="Login" method="post">

    <div>
        <label>Email</label>
        <input asp-for="Email" />
    </div>

    <br />

    <div>
        <label>Password</label>
        <input asp-for="Password" type="password" />
    </div>

    <br />

    <button type="submit">
        Login
    </button>

</form>